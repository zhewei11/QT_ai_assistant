# Copy to config/ecg_integration.env on the robot and adjust deployment values.

ECG_ENABLED=true
ECG_REQUIRED=false
ECG_MEASURE_ON_START=false
ECG_OPEN_DASHBOARD_ON_START=false
ECG_MEASUREMENT_SECONDS=60
ECG_SAMPLE_RATE_HZ=375
ECG_SIGNAL_WAIT_TIMEOUT_SECONDS=120
ECG_STREAM_GAP_TIMEOUT_SECONDS=5
ECG_WAIT_DEBUG_INTERVAL=3
ECG_MAX_AGE_SECONDS=21600
ECG_BRADYCARDIA_BPM=50
ECG_TACHYCARDIA_BPM=100
ECG_IRREGULAR_SCORE_THRESHOLD=0.50
ECG_AF_PATTERN_SCORE_THRESHOLD=0.68
ECG_PREMATURE_SCORE_THRESHOLD=0.50
ECG_MIN_SIGNAL_QUALITY=0.50
ECG_YBC_MODEL_ENABLED=false
ECG_YBC_MAX_BEATS=80
ECG_YBC_BATCH_SIZE=32
ECG_YBC_TIMEOUT_SECONDS=5
ECG_PROCESS_NICE=5
ECG_FIREBASE_DATABASE_URL=https://ecg-monitor-bf64d-default-rtdb.firebaseio.com
ECG_FIREBASE_DEVICE_PATH=devices/yuguard_01
ECG_DASHBOARD_URL=https://ecg-monitor-bf64d.web.app

FACE_RECOGNITION_ENABLED=false
FACE_MEMORY_ENABLED=false
FACE_MEMORY_FILE=runtime/face_memory.json
FACE_MEMORY_MAX_PEOPLE=4
FACE_CURRENT_TTL_SECONDS=30
FACE_MEMORY_TOPIC=/qt_nuitrack_app/faces
FACE_MEMORY_DEBUG_LOG_INTERVAL=2.0

FACE_CAMERA_TOPIC=/camera/color/image_raw
FACE_CAMERA_VIEWER=auto
FACE_CAMERA_WEB_PORT=8090
FACE_CAMERA_STREAM_HOST=

AI_TERMINAL_DEBUG=normal
AI_LOG_LEVEL=WARNING
AI_LIBRARY_LOG_LEVEL=WARNING

# QTrobot face Raspberry Pi SSH connection.
# Example: QT_FACE_HOST=192.168.100.2
QT_FACE_HOST=
QT_FACE_USER=qtrobot
QT_FACE_DISPLAY=:0
